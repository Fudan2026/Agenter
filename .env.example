# Supro environment (Vite + Cloudflare Pages Functions)
#
# CRITICAL: use a NEW Supabase Organization + Project for Supro Auth.
#   Do NOT reuse the Letus IELTS org (confirm-email redirects would hit IELTS).
#   Do NOT migrate Letus users — fresh signup only.
# SQL: apply supabase/supro.sql in the NEW project's SQL Editor.
#
# cloud_not_configured on /api/signup means Pages Functions cannot see Supabase.
# You need BOTH:
#   A) GitHub Actions secrets (build-time browser): VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY
#   B) Cloudflare Pages project `supro` → Settings → Environment variables → Production:
#        SUPABASE_URL
#        SUPABASE_ANON_KEY
#        SUPABASE_SERVICE_ROLE_KEY
#        LLM_BACKEND=deepseek
#        LLM_API_KEY
#        LLM_MODEL=deepseek-chat
# Deploy workflow also syncs A→B when SUPABASE_* or VITE_SUPABASE_* exist in GitHub secrets.
# After changing Pages env: Redeploy main (or push) so Functions pick up secrets.

## Vite (browser — anon only; GitHub Actions secrets)
VITE_BASE=/
VITE_SUPABASE_URL=https://YOUR_NEW_SUPRO_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supro_anon_key

## Cloudflare Pages Function secrets (required for /api/signup · /api/password-login · /api/fin-desk)
# SUPABASE_URL=https://YOUR_NEW_SUPRO_PROJECT.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# LLM_BACKEND=deepseek
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# IWENCAI_API_KEY=   (bake only; never to browser; zero LLM)

## GitHub Actions
# CF_API_TOKEN=
# CF_ACCOUNT_ID=
# VITE_SUPABASE_URL=   (same as above)
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_URL=        (optional alias; deploy syncs to Pages)
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# LLM_API_KEY=
# IWENCAI_API_KEY=

## Supabase Dashboard (owner — NEW Supro org/project)
# Auth → Enable email confirmations (disable autoconfirm)
# Auth → Site URL: https://supro.si
# Auth → Redirect URLs: https://supro.si/** , https://www.supro.si/** , Pages preview
# Optional: App Metadata { "role": "admin" } on seanfudan@163.com
# SQL editor: supabase/supro.sql
