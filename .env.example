# Agenter environment (public Vite + CF Functions secrets)

## Vite (browser — anon only)
VITE_BASE=/
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

## Cloudflare Pages Function secrets (wrangler pages secret put)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# LLM_BACKEND=openai|deepseek|anthropic
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# IWENCAI_API_KEY=   (bake only; never to browser)

## GitHub Actions
# CF_API_TOKEN=
# CF_ACCOUNT_ID=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# IWENCAI_API_KEY=
